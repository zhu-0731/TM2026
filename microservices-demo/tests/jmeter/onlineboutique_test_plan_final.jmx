        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor - Groovy" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">// Groovy script for extracting and validating response data
import groovy.json.JsonSlurper

def responseCode = prev.getResponseCode()
def responseData = prev.getResponseDataAsString()
def url = prev.getUrlAsString()

// Log response info
log.info(&quot;Request URL: ${url}&quot;)
log.info(&quot;Response Code: ${responseCode}&quot;)

// Validate response code
if (responseCode != &quot;200&quot;) {
    log.error(&quot;Request failed with code: ${responseCode}, URL: ${url}&quot;)
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;Expected 200 but got ${responseCode}&quot;)
}

// Extract session cookie if present
def cookies = prev.getResponseHeaders()
if (cookies.contains(&quot;session&quot;)) {
    def sessionMatch = (cookies =~ /session=([^;]+)/)
    if (sessionMatch) {
        def sessionId = sessionMatch[0][1]
        vars.put(&quot;SESSION_ID&quot;, sessionId)
        log.info(&quot;Session ID extracted: ${sessionId}&quot;)
    }
}

// Parse JSON response if applicable
if (responseData &amp;&amp; responseData.startsWith(&quot;{&quot;)) {
    try {
        def json = new JsonSlurper().parseText(responseData)
        log.info(&quot;JSON Response parsed successfully&quot;)
    } catch (Exception e) {
        log.warn(&quot;Failed to parse JSON response: ${e.getMessage()}&quot;)
    }
}

// Calculate response time
def responseTime = prev.getTime()
if (responseTime &gt; 2000) {
    log.warn(&quot;Slow response detected: ${responseTime}ms for ${url}&quot;)
}</stringProp>
        </JSR223PostProcessor>
